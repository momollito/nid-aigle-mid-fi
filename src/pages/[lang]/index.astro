---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/home/Hero.astro";
import Intro from "../../components/home/Intro.astro";
import Triptych from "../../components/home/Triptych.astro";
import Cards from "../../components/home/Cards.astro";
import { dictionaries, useTranslations, getLangFromUrl } from "../../i18n";

export function getStaticPaths() {
  return Object.keys(dictionaries).map((lang) => ({ params: { lang } }));
}

const t = useTranslations(getLangFromUrl(Astro.url));
---

<Layout title={t.meta.home.title} description={t.meta.home.description}>
  <Hero />
  <Intro />
  <Triptych />
  <Cards />
</Layout>
