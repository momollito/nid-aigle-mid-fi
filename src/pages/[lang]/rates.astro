---
import Layout from "../../layouts/Layout.astro";
import TarifsHeader from "../../components/tarifs/TarifsHeader.astro";
import Reservation from "../../components/tarifs/Reservation.astro";
import PricingTable from "../../components/tarifs/PricingTable.astro";
import PricingNotes from "../../components/tarifs/PricingNotes.astro";
import { dictionaries, useTranslations, getLangFromUrl } from "../../i18n";

export function getStaticPaths() {
  return Object.keys(dictionaries).map((lang) => ({ params: { lang } }));
}

const t = useTranslations(getLangFromUrl(Astro.url));
---

<Layout title={t.meta.tarifs.title} description={t.meta.tarifs.description}>
  <TarifsHeader />
  <Reservation />
  <PricingTable />
  <PricingNotes />
</Layout>
