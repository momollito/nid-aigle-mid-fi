---
import Layout from "../../layouts/Layout.astro";
import AboutHeader from "../../components/about/AboutHeader.astro";
import History from "../../components/about/History.astro";
import Timeline from "../../components/about/Timeline.astro";
import Geography from "../../components/about/Geography.astro";
import Role from "../../components/about/Role.astro";
import { getLangFromUrl, useTranslations } from "../../i18n";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<Layout title={t.meta.about.title} description={t.meta.about.description}>
  <AboutHeader />
  <History />
  <Timeline />
  <Geography />
  <Role />
</Layout>
