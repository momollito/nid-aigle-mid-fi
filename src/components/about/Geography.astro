---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "../../i18n";
import tramwayImg from "../../assets/about/tramway.jpg";

const { geography } = useTranslations(getLangFromUrl(Astro.url)).about;
---

<section
  class="grid grid-cols-1 items-start gap-10 bg-[#ecebe4] px-6 py-16 md:px-[8%] md:py-24 lg:grid-cols-[1.4fr_1fr] lg:items-center lg:gap-15 lg:py-22.5"
>
  <div>
    <div class="eyebrow">{geography.eyebrow}</div>
    <h2 class="serif mb-5.5 mt-3.5 text-h2" set:html={geography.title} />
    <p class="max-w-135 font-sans text-[15px] leading-[1.75] text-ink">{geography.body}</p>

    <div class="mt-9 grid max-w-115 grid-cols-2 gap-5">
      {
        geography.stats.map((s) => (
          <div class="border-t border-line-strong pt-3">
            <div class="serif text-stat italic">{s.value}</div>
            <div class="eyebrow">{s.label}</div>
          </div>
        ))
      }
    </div>
  </div>

  <Image
    src={tramwayImg}
    alt={geography.imageAlt}
    widths={[600, 900, 1400]}
    sizes="(min-width: 1024px) 40vw, 92vw"
    loading="lazy"
    decoding="async"
    class="aspect-4/3 w-full rounded-sm border border-line-strong object-cover lg:aspect-auto lg:h-110"
  />
</section>
