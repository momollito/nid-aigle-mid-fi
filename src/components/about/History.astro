---
import { getLangFromUrl, useTranslations } from "../../i18n";

const { history } = useTranslations(getLangFromUrl(Astro.url)).about;
---

<section
  class="grid grid-cols-1 items-start gap-10 px-6 py-16 md:px-[8%] md:py-24 lg:grid-cols-[1fr_1.6fr] lg:gap-20 lg:py-22.5"
>
  <div>
    <div class="eyebrow">{history.eyebrow}</div>
    <h2 class="serif mt-3 text-h2-sm" set:html={history.title} />
  </div>

  <div class="flex flex-col gap-5.5">
    {history.paragraphs.map((p) => <p class="font-sans text-[15px] leading-[1.75] text-ink">{p}</p>)}
  </div>
</section>
