---
import { getLangFromUrl, useTranslations } from "../../i18n";

const { role } = useTranslations(getLangFromUrl(Astro.url)).about;
---

<section class="px-[8%] pb-[130px] pt-[110px]">
  <div class="eyebrow">{role.eyebrow}</div>
  <h2 class="serif mb-8 mt-[14px] max-w-[900px] text-[54px]" set:html={role.title} />

  <div class="grid grid-cols-3 gap-[30px]">
    {
      role.items.map((item) => (
        <div class="border-t border-line-strong pt-[18px]">
          <div class="eyebrow">{item.kicker}</div>
          <h3 class="serif mb-3 mt-2 text-[30px]">{item.title}</h3>
          <p class="font-sans text-[14px] leading-[1.7] text-muted">{item.text}</p>
        </div>
      ))
    }
  </div>
</section>
