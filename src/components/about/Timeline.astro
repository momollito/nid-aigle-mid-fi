---
import { getLangFromUrl, useTranslations } from "../../i18n";

const { timeline } = useTranslations(getLangFromUrl(Astro.url)).about;
---

<section class="px-6 pb-16 md:px-[8%] lg:pb-22.5">
  <div class="border-t border-line-strong">
    {
      timeline.map((entry) => (
        <div class="grid grid-cols-[64px_1fr] gap-4 border-b border-line py-5 lg:grid-cols-[180px_1fr] lg:gap-5 lg:py-5.5">
          <span class="serif text-stat italic text-muted">{entry.year}</span>
          <div class="self-center whitespace-pre-line font-sans text-[14px] leading-[1.7] text-ink">
            {entry.text}
          </div>
        </div>
      ))
    }
  </div>
</section>
