---
import { getLangFromUrl, useTranslations } from "../../i18n";
import Placeholder from "../ui/Placeholder.astro";

const { header } = useTranslations(getLangFromUrl(Astro.url)).about;
---

<section class="px-[8%] pb-[30px] pt-[130px]">
  <div class="eyebrow">{header.eyebrow}</div>
  <h1 class="serif mt-[14px] text-[92px]" set:html={header.title} />
</section>

<section class="px-[8%] pt-[30px]">
  <Placeholder label="Photo d'archive · construction, 1933" class="h-[440px]" />
</section>
