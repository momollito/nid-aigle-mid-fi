---
import { getLangFromUrl, useTranslations, localizedPath, type RouteKey } from "../i18n";
import LangSwitcher from "./LangSwitcher.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links: RouteKey[] = ["tarifs", "about"];

const here = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (key: RouteKey) => {
  const target = localizedPath(lang, key).replace(/\/+$/, "") || "/";
  return here === target;
};
---

<header class="absolute inset-x-0 top-5.5 z-30 flex justify-center px-6">
  <nav
    class="flex items-center gap-4 rounded-full border border-line-strong bg-paper/95 py-2 pl-5.5 pr-2 shadow-[0_6px_20px_-10px_rgba(0,0,0,0.18)] backdrop-blur-sm lg:gap-6 lg:pr-5.5"
  >
    <a
      href={localizedPath(lang, "home")}
      class="flex items-center gap-2 font-serif text-[19px] italic text-ink no-underline"
    >
      Refuge du Nid d'Aigle
    </a>

    <!-- Liens inline (desktop) -->
    <div class="hidden items-center gap-6 lg:flex">
      {
        links.map((key) => (
          <a
            href={localizedPath(lang, key)}
            class:list={[
              "font-sans text-[13px] no-underline",
              isActive(key) ? "text-ink" : "text-muted",
            ]}
          >
            {t.nav[key]}
          </a>
        ))
      }
      <a
        href={localizedPath(lang, "contact")}
        class="rounded-full bg-ink px-5 py-2.5 font-sans text-[13px] text-paper no-underline"
      >
        {t.nav.contact}
      </a>
      <div class="-ml-2.5 flex items-center gap-3.5">
        <span class="h-4 w-px bg-line-strong"></span>
        <LangSwitcher />
      </div>
    </div>

    <!-- Menu déroulant (mobile) — élément <details> natif, sans JS -->
    <details class="relative lg:hidden">
      <summary
        class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-full text-ink"
        aria-label="Menu"
      >
        <svg
          class="icon-burger"
          width="18"
          height="18"
          viewBox="0 0 18 18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        >
          <path d="M2 5h14M2 9h14M2 13h14"></path>
        </svg>
        <svg
          class="icon-close"
          width="18"
          height="18"
          viewBox="0 0 18 18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        >
          <path d="M4 4l10 10M14 4L4 14"></path>
        </svg>
      </summary>

      <div
        class="absolute right-0 top-[calc(100%+12px)] flex w-55 flex-col gap-1 rounded-2xl border border-line-strong bg-paper p-3 shadow-[0_12px_30px_-12px_rgba(0,0,0,0.28)]"
      >
        {
          links.map((key) => (
            <a
              href={localizedPath(lang, key)}
              class:list={[
                "rounded-lg px-3 py-2 font-sans text-[14px] no-underline",
                isActive(key) ? "bg-fill-soft text-ink" : "text-ink",
              ]}
            >
              {t.nav[key]}
            </a>
          ))
        }
        <a
          href={localizedPath(lang, "contact")}
          class="mt-1 rounded-full bg-ink px-4 py-2.5 text-center font-sans text-[14px] text-paper no-underline"
        >
          {t.nav.contact}
        </a>
        <div class="mt-2 flex justify-center border-t border-line pt-3">
          <LangSwitcher />
        </div>
      </div>
    </details>
  </nav>
</header>

<style>
  /* Masque le marqueur natif du <summary> et bascule burger ↔ croix. */
  summary {
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  details[open] .icon-burger {
    display: none;
  }
  details:not([open]) .icon-close {
    display: none;
  }
</style>
