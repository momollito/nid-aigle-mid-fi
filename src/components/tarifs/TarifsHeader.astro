---
import { getLangFromUrl, useTranslations } from "../../i18n";
import Lines from "../ui/Lines.astro";

const { header } = useTranslations(getLangFromUrl(Astro.url)).tarifs;
---

<section
  class="border-b border-line-strong px-6 pb-12 pt-28 md:px-[8%] lg:pb-12.5 lg:pt-32.5"
>
  <div class="eyebrow">{header.eyebrow}</div>
  <h1 class="serif mt-3.5 text-title" set:html={header.title} />
  <div class="mt-6 max-w-135">
    <Lines count={2} widths={["100%", "72%"]} />
  </div>
</section>
