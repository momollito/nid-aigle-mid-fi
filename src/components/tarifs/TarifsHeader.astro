---
import { getLangFromUrl, useTranslations } from "../../i18n";
import Lines from "../ui/Lines.astro";

const { header } = useTranslations(getLangFromUrl(Astro.url)).tarifs;
---

<section class="border-b border-line-strong px-[8%] pb-[50px] pt-[130px]">
  <div class="eyebrow">{header.eyebrow}</div>
  <h1 class="serif mt-[14px] text-[84px]" set:html={header.title} />
  <div class="mt-6 max-w-[540px]">
    <Lines count={2} widths={["100%", "72%"]} />
  </div>
</section>
