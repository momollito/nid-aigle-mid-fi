---
import { getLangFromUrl, useTranslations } from "../../i18n";
import Button from "../ui/Button.astro";

const { booking, practical } = useTranslations(getLangFromUrl(Astro.url)).tarifs;
---

<section
  class="grid grid-cols-1 gap-12 px-6 pt-12 md:px-[8%] lg:grid-cols-[1.4fr_1fr] lg:gap-20 lg:pt-17.5"
>
  <!-- Colonne réservation -->
  <div>
    <div class="eyebrow">{booking.eyebrow}</div>
    <h2 class="serif mb-5 mt-3 text-h2-sm" set:html={booking.title} />
    <p class="mb-7 max-w-135 font-sans text-[15px] leading-[1.75] text-ink">{booking.intro}</p>

    <Button href={booking.ctaHref} variant="primary" size="lg" target="_blank">{booking.cta}</Button>

    <p
      class="mt-6 max-w-135 font-sans text-[13px] leading-[1.7] text-muted [&_a]:text-ink [&_a]:underline"
      set:html={booking.fallback}
    />
  </div>

  <!-- Colonne « en pratique » -->
  <aside class="flex flex-col gap-7">
    <div>
      <div class="eyebrow">{practical.eyebrow}</div>
      <h3 class="serif mb-4 mt-2.5 text-h3" set:html={practical.title} />
      <div class="flex flex-col gap-3.5">
        {
          practical.rows.map((row) => (
            <div class="grid grid-cols-[100px_1fr] gap-4 border-b border-line pb-3.5">
              <span class="eyebrow">{row.label}</span>
              <span class="font-sans text-[14px] leading-normal text-ink">{row.value}</span>
            </div>
          ))
        }
      </div>
    </div>
  </aside>
</section>
