---
import { getLangFromUrl, useTranslations } from "../../i18n";

const { pricing } = useTranslations(getLangFromUrl(Astro.url)).tarifs;
const cols = "grid-cols-[2fr_1fr_1fr_1fr_1fr]";
---

<!-- Séparateur -->
<div class="mx-6 mt-16 h-px bg-line-strong md:mx-[8%] lg:mt-20"></div>

<section class="px-6 pt-12 md:px-[8%] lg:pt-17.5">
  <div class="eyebrow mb-7">{pricing.eyebrow}</div>

  <!-- Sur mobile la grille 5 colonnes défile horizontalement -->
  <div class="overflow-x-auto rounded-sm border border-line-strong bg-paper">
    <div class="min-w-170">
      <!-- En-tête -->
      <div class:list={["grid border-b border-line-strong bg-[#ecebe4]", cols]}>
        {
          pricing.columns.map((col, i) => (
            <div class:list={["eyebrow px-5.5 py-4.5", i === 0 ? "text-left" : "text-right"]}>
              {col}
            </div>
          ))
        }
      </div>

      <!-- Lignes -->
      {
        pricing.rows.map((row, i) => (
          <div
            class:list={["grid", cols, i < pricing.rows.length - 1 ? "border-b border-line" : ""]}
          >
            <div class="px-5.5 py-5">
              <div class="serif text-[22px]">{row.name}</div>
              <div class="mt-1.5 font-sans text-[12.5px] text-muted">{row.sub}</div>
            </div>
            {row.prices.map((p) => (
              <div class="flex items-center justify-end px-5.5 py-5">
                <span class:list={["serif text-[20px]", p === "—" ? "text-muted" : "text-ink"]}>
                  {p}
                </span>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <div class="mt-3.5 font-sans text-[13px] text-muted">{pricing.note}</div>
</section>
