---
import { getLangFromUrl, useTranslations } from "../../i18n";
import Chip from "../ui/Chip.astro";

const { map } = useTranslations(getLangFromUrl(Astro.url)).contact;

// Cercles concentriques décoratifs de la carte indicative.
const rings = Array.from({ length: 7 }, (_, i) => 50 + i * 48);
---

<section class="px-6 md:px-[8%]">
  <div
    class="relative h-80 overflow-hidden rounded-sm border border-line-strong md:h-115"
    style="background:repeating-linear-gradient(45deg, transparent 0 20px, rgba(0,0,0,0.035) 20px 21px), #e9e8e1"
  >
    <svg
      width="100%"
      height="100%"
      viewBox="0 0 1000 460"
      preserveAspectRatio="none"
      class="absolute inset-0"
    >
      {
        rings.map((r) => (
          <ellipse cx="600" cy="210" rx={r * 1.2} ry={r * 0.7} fill="none" stroke="#a8a59b" stroke-width="1" />
        ))
      }
      <path
        d="M 0 380 Q 200 360 350 400 T 700 420 T 1000 460"
        fill="none"
        stroke="#9fb0bd"
        stroke-width="3"></path>
      <path
        d="M 100 440 Q 300 400 480 360 T 600 210"
        fill="none"
        stroke="#8a887f"
        stroke-width="1.5"
        stroke-dasharray="5 5"></path>
    </svg>

    <!-- Épingle -->
    <div class="absolute left-[60%] top-[40%]" style="transform:translate(-50%,-100%)">
      <div
        class="whitespace-nowrap rounded-sm border border-line-strong bg-paper px-3.5 py-2.5 shadow-[0_8px_22px_-10px_rgba(0,0,0,0.3)]"
      >
        <span class="serif text-[16px] italic">{map.tooltip}</span>
      </div>
      <div class="mx-auto h-4 w-px bg-ink"></div>
      <div class="mx-auto h-3 w-3 rounded-full bg-ink"></div>
    </div>

    <Chip class="absolute bottom-4 left-4">{map.chip}</Chip>
  </div>
</section>
