---
import { getLangFromUrl, useTranslations, localizedPath } from "../../i18n";
import Chip from "../ui/Chip.astro";
import Button from "../ui/Button.astro";

const lang = getLangFromUrl(Astro.url);
const { access, coords } = useTranslations(lang).contact;
---

<section
  class="grid grid-cols-1 gap-12 px-6 pb-16 pt-12 md:px-[8%] lg:grid-cols-[1.4fr_1fr] lg:gap-17.5 lg:pb-27.5 lg:pt-17.5"
>
  <!-- Les deux accès -->
  <div>
    <div class="eyebrow">{access.eyebrow}</div>
    <h2 class="serif mb-8 mt-3 text-h2 lg:mb-7.5" set:html={access.title} />

    {
      access.routes.map((route) => (
        <div class="grid grid-cols-[44px_1fr] items-start gap-4 border-t border-line-strong py-6 lg:grid-cols-[60px_1fr_auto] lg:gap-5 lg:py-6.5">
          <span class="eyebrow">{route.n}</span>
          <div>
            <div class="flex flex-wrap items-center gap-3">
              <div class="serif text-h4">{route.title}</div>
              {/* Étiquette inline sur mobile, colonne dédiée sur desktop */}
              <span class="lg:hidden">
                <Chip>{route.tag}</Chip>
              </span>
            </div>
            <div
              class="mt-3 font-sans text-[14px] leading-[1.7] text-ink [&_a]:text-ink [&_a]:underline"
              set:html={route.desc}
            />
          </div>
          <span class="hidden lg:block">
            <Chip>{route.tag}</Chip>
          </span>
        </div>
      ))
    }
    <div class="border-t border-line-strong"></div>
  </div>

  <!-- Coordonnées -->
  <aside>
    <div class="eyebrow">{coords.eyebrow}</div>
    <div class="mt-3.5 flex flex-col gap-5.5">
      {
        coords.rows.map((row) => (
          <div class="flex flex-col gap-2 border-b border-line pb-4">
            <span class="eyebrow">{row.label}</span>
            <span class="serif text-[22px] italic">{row.value}</span>
          </div>
        ))
      }
    </div>
    <Button href={localizedPath(lang, "tarifs")} variant="primary" class="mt-6">{coords.cta}</Button>
  </aside>
</section>
