---
/** Étiquette arrondie (repris de `.chip` du wireframe). */
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center gap-2 rounded-full border border-line-strong bg-paper px-3.5 py-1.5 font-mono text-[10px] uppercase tracking-[0.08em] text-ink",
    className,
  ]}
>
  <slot />
</span>
