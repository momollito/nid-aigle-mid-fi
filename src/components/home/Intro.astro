---
import { getLangFromUrl, useTranslations, localizedPath } from "../../i18n";

const lang = getLangFromUrl(Astro.url);
const { intro } = useTranslations(lang).home;
---

<section
  class="grid grid-cols-1 gap-10 px-6 py-16 md:px-[8%] md:py-24 lg:grid-cols-[1fr_1.4fr] lg:gap-20 lg:py-25"
>
  <div>
    <div class="eyebrow">{intro.eyebrow}</div>
    <h2 class="serif mt-3.5 text-h2" set:html={intro.title} />
  </div>

  <div class="flex max-w-155 flex-col gap-5">
    <p class="font-sans text-[15px] leading-[1.75] text-ink">{intro.body}</p>
    <div class="mt-2">
      <a
        href={localizedPath(lang, "about")}
        class="eyebrow border-b border-ink pb-1 text-ink no-underline"
      >
        {intro.link}
      </a>
    </div>
  </div>
</section>
