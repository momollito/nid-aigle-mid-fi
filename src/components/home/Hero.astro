---
import { getLangFromUrl, useTranslations, localizedPath } from "../../i18n";
import Placeholder from "../ui/Placeholder.astro";
import Button from "../ui/Button.astro";

const lang = getLangFromUrl(Astro.url);
const { hero } = useTranslations(lang).home;
---

<section class="relative h-[700px] border-b border-line-strong">
  <Placeholder label="Photo refuge 'Wow'" dark frame={false} class="absolute inset-0 h-full w-full" />

  <!-- Dégradé sombre en pied de héros -->
  <div
    class="absolute inset-0 z-[1]"
    style="background:linear-gradient(to top, rgba(20,19,18,0.82) 0%, rgba(20,19,18,0.2) 45%, transparent 70%)"
  >
  </div>

  <!-- Bas-gauche : eyebrow + titre + CTA -->
  <div class="absolute bottom-0 left-0 z-[2] max-w-[720px] px-[52px] pb-[44px]">
    <div class="eyebrow mb-4 text-[#b8b5ad]">{hero.eyebrow}</div>
    <h1 class="serif mb-[28px] text-[76px] leading-none text-[#f4f3ef]" set:html={hero.title} />
    <Button href={localizedPath(lang, "tarifs")} variant="primary">{hero.cta}</Button>
  </div>

  <!-- Bas-droite : statistiques -->
  <div
    class="absolute bottom-0 right-0 z-[2] flex flex-col items-end gap-[18px] px-[52px] pb-[44px]"
  >
    {
      hero.stats.map((s) => (
        <div class="flex flex-col items-end gap-[2px]">
          <span class="eyebrow text-[#8a8780]">{s.label}</span>
          <span class="serif text-[20px] italic text-[#f4f3ef]">{s.value}</span>
        </div>
      ))
    }
  </div>
</section>
