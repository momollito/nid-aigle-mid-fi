---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations, localizedPath } from "../../i18n";
import Button from "../ui/Button.astro";
import heroImg from "../../assets/home/hero.jpg";

const lang = getLangFromUrl(Astro.url);
const { hero } = useTranslations(lang).home;
---

<section
  class="relative flex min-h-[85svh] flex-col justify-end overflow-hidden border-b border-line-strong lg:block lg:h-175"
>
  <Image
    src={heroImg}
    alt={hero.alt}
    width={2560}
    widths={[768, 1280, 1920, 2560]}
    sizes="100vw"
    priority
    class="absolute inset-0 h-full w-full object-cover"
  />

  <!-- Dégradé sombre en pied de héros -->
  <div
    class="absolute inset-0 z-1"
    style="background:linear-gradient(to top, rgba(20,19,18,0.82) 0%, rgba(20,19,18,0.2) 45%, transparent 70%)"
  >
  </div>

  <!-- Contenu : empilé sur mobile, réparti gauche/droite sur desktop -->
  <div
    class="relative z-2 flex flex-col gap-10 px-6 pb-10 md:px-10 lg:absolute lg:inset-0 lg:flex-row lg:items-end lg:justify-between lg:gap-6 lg:px-13 lg:pb-11"
  >
    <!-- Titre + CTA -->
    <div class="lg:max-w-180">
      <div class="eyebrow mb-4 text-[#b8b5ad]">{hero.eyebrow}</div>
      <h1 class="serif mb-6 text-display text-[#f4f3ef] lg:mb-7" set:html={hero.title} />
      <Button href={localizedPath(lang, "tarifs")} variant="primary">{hero.cta}</Button>
    </div>

    <!-- Statistiques -->
    <div class="grid grid-cols-2 gap-x-8 gap-y-4 lg:flex lg:flex-col lg:items-end lg:gap-4.5">
      {
        hero.stats.map((s) => (
          <div class="flex flex-col gap-0.5 lg:items-end">
            <span class="eyebrow text-[#8a8780]">{s.label}</span>
            <span class="serif text-[20px] italic text-[#f4f3ef]">{s.value}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
