---
import { getLangFromUrl, useTranslations, localizedPath, type RouteKey } from "../../i18n";

const lang = getLangFromUrl(Astro.url);
const { cards } = useTranslations(lang).home;
---

<section class="px-6 pb-16 md:px-[8%] lg:pb-30">
  <div class="mb-7">
    <div class="eyebrow">{cards.eyebrow}</div>
    <h2 class="serif mt-2.5 text-h2-sm">{cards.title}</h2>
  </div>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
    {
      cards.items.map((item) => (
        <a
          href={localizedPath(lang, item.target as RouteKey)}
          class="flex min-h-55 flex-col gap-3.5 rounded-sm border border-line-strong bg-paper p-7 no-underline"
        >
          <span class="eyebrow">{item.n}</span>
          <h3 class="serif text-h3">{item.title}</h3>
          <p class="font-sans text-[14px] leading-[1.7] text-muted">{item.desc}</p>
          <span class="eyebrow mt-auto">{cards.more}</span>
        </a>
      ))
    }
  </div>
</section>
